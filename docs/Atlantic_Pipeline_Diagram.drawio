        <mxCell id="p6-k2-bg" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="462" y="2492" width="372" height="156" as="geometry"/></mxCell>
        <mxCell id="p6-k2-title" value='&lt;b style="font-size:12px;color:#0f172a"&gt;Persistence&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="480" y="2506" width="336" height="18" as="geometry"/></mxCell>
        <mxCell id="p6-k2-body" value='&lt;div style="line-height:1.7"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:10px;color:#0f172a;"&gt;atl.save(path)&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:10px;color:#0f172a;"&gt;Atlantic.load(path)&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:10px;color:#0f172a;"&gt;pipeline.save(path)&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:10px;color:#0f172a;"&gt;AtlanticPipeline.load(path)&lt;/span&gt;&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="480" y="2532" width="336" height="80" as="geometry"/></mxCell>
        <mxCell id="p6-k2-note" value="pickle · stamped with the Atlantic version · the training DataFrame is not stored · load only files you trust" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=9.5;fontColor=#64748b;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="480" y="2608" width="336" height="32" as="geometry"/></mxCell>
