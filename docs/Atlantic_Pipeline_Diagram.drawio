        <mxCell id="p3-vif-no" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Keep All Columns&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;example run: 17.477 with the&lt;br&gt;filter vs 17.426 without&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="1766" width="220" height="56" as="geometry"/></mxCell>
