        <mxCell id="e3-c-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#c4b5fd;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" edge="1" parent="1" source="p3-vif" target="p3-improve"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3-c-yes" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#c4b5fd;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#15803d;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p3-improve" target="p3-vif-yes"><mxGeometry relative="1" x="0.52" as="geometry"><mxPoint x="0" y="-9" as="offset"/><Array as="points"><mxPoint x="500" y="1759"/><mxPoint x="500" y="1731"/></Array></mxGeometry></mxCell>
        <mxCell id="e3-c-no" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#c4b5fd;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#b91c1c;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p3-improve" target="p3-vif-no"><mxGeometry relative="1" x="0.56" as="geometry"><mxPoint x="0" y="9" as="offset"/><Array as="points"><mxPoint x="500" y="1759"/><mxPoint x="500" y="1794"/></Array></mxGeometry></mxCell>
        <mxCell id="e3-c-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#c4b5fd;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p3-vif-yes" target="p3-chosen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775" y="1731"/><mxPoint x="775" y="1743"/></Array></mxGeometry></mxCell>
        <mxCell id="e3-c-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#c4b5fd;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p3-vif-no" target="p3-chosen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775" y="1794"/><mxPoint x="775" y="1777"/></Array></mxGeometry></mxCell>
        <mxCell id="p3-eng-bg" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1010" y="1210" width="620" height="612" as="geometry"/></mxCell>
        <mxCell id="p3-eng-label" value='&lt;span style="letter-spacing:0.07em"&gt;&lt;b&gt;HOW EVERY CANDIDATE IS SCORED&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style="font-family:JetBrains Mono,monospace;font-size:10px;color:#5b21b6;font-weight:bold;"&gt;ModelEvaluator&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=9.5;fontColor=#64748b;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="1028" y="1224" width="580" height="18" as="geometry"/></mxCell>
        <mxCell id="p3-eng-n0" value="1" style="ellipse;whiteSpace=wrap;fillColor=#7c3aed;strokeColor=none;fontColor=#ffffff;fontSize=10;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1028" y="1254" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="p3-eng-s0" value="Fit the candidate on the train split, then transform both the train and the validation rows." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="1256" width="548" height="34" as="geometry"/></mxCell>
        <mxCell id="p3-eng-n1" value="2" style="ellipse;whiteSpace=wrap;fillColor=#7c3aed;strokeColor=none;fontColor=#ffffff;fontSize=10;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1028" y="1296" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="p3-eng-s1" value="An Optuna TPE search, seeded by &lt;b&gt;random_state&lt;/b&gt;, runs &lt;b&gt;n trials&lt;/b&gt; (see the table below)." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="1298" width="548" height="34" as="geometry"/></mxCell>
        <mxCell id="p3-eng-n2" value="3" style="ellipse;whiteSpace=wrap;fillColor=#7c3aed;strokeColor=none;fontColor=#ffffff;fontSize=10;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1028" y="1338" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="p3-eng-s2" value="Every trial tunes RandomForest, ExtraTrees and XGBoost, fits them on train and scores them on validation." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="1340" width="548" height="34" as="geometry"/></mxCell>
        <mxCell id="p3-eng-n3" value="4" style="ellipse;whiteSpace=wrap;fillColor=#7c3aed;strokeColor=none;fontColor=#ffffff;fontSize=10;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1028" y="1380" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="p3-eng-s3" value="Candidate score = the mean, over the three models, of each model's best trial." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="1382" width="548" height="34" as="geometry"/></mxCell>
        <mxCell id="p3-eng-n4" value="5" style="ellipse;whiteSpace=wrap;fillColor=#7c3aed;strokeColor=none;fontColor=#ffffff;fontSize=10;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1028" y="1422" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="p3-eng-s4" value="Lowest MAE wins for regression; highest Precision (2 classes) or F1 (more classes) for classification." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="1424" width="548" height="34" as="geometry"/></mxCell>
        <mxCell id="p3-eng-models" value='&lt;span style="letter-spacing:0.07em"&gt;MODELS TUNED IN EVERY TRIAL&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=9.5;fontColor=#64748b;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1028" y="1472" width="420" height="14" as="geometry"/></mxCell>
        <mxCell id="p3-eng-m0" value='&lt;b style="font-size:11px;color:#0f172a"&gt;RandomForest&lt;/b&gt;&lt;div style="margin-top:2px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9px;color:#64748b;"&gt;n_estimators · max_depth&lt;br&gt;min_samples_split&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#ddd6fe;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1028" y="1492" width="188" height="56" as="geometry"/></mxCell>
        <mxCell id="p3-eng-m1" value='&lt;b style="font-size:11px;color:#0f172a"&gt;ExtraTrees&lt;/b&gt;&lt;div style="margin-top:2px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9px;color:#64748b;"&gt;n_estimators · max_depth&lt;br&gt;min_samples_split&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#ddd6fe;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1224" y="1492" width="188" height="56" as="geometry"/></mxCell>
        <mxCell id="p3-eng-m2" value='&lt;b style="font-size:11px;color:#0f172a"&gt;XGBoost&lt;/b&gt;&lt;div style="margin-top:2px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9px;color:#64748b;"&gt;n_estimators · max_depth&lt;br&gt;learning_rate (log scale)&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#ddd6fe;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1420" y="1492" width="188" height="56" as="geometry"/></mxCell>
        <mxCell id="p3-eng-budget" value='&lt;span style="letter-spacing:0.07em"&gt;TRIALS PER CANDIDATE  ·  DATA SIZE × OPTIMIZATION_LEVEL&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=9.5;fontColor=#64748b;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1028" y="1564" width="420" height="14" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-h0" value="Data size" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#f8fafc;fontSize=9.5;fontStyle=1;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1028" y="1584" width="268" height="22" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r0c0" value='&lt;b&gt;Small&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;&amp;lt; 5,000 rows · &amp;lt; 30 features&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1028" y="1606" width="268" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r1c0" value='&lt;b&gt;Medium&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;&amp;lt; 20,000 · &amp;lt; 100&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1028" y="1630" width="268" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r2c0" value='&lt;b&gt;Large&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;&amp;lt; 100,000 · &amp;lt; 500&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1028" y="1654" width="268" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r3c0" value='&lt;b&gt;Extra-large&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;anything bigger&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1028" y="1678" width="268" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-h1" value="fast" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#f8fafc;fontSize=9.5;fontStyle=1;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1296" y="1584" width="104" height="22" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r0c1" value='&lt;b style="color:#0f172a"&gt;5&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ede9fe;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1296" y="1606" width="104" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r1c1" value='&lt;b style="color:#0f172a"&gt;4&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ede9fe;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1296" y="1630" width="104" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r2c1" value='&lt;b style="color:#0f172a"&gt;3&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#f5f3ff;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1296" y="1654" width="104" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r3c1" value='&lt;b style="color:#0f172a"&gt;2&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#f5f3ff;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1296" y="1678" width="104" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-h2" value="balanced" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#f8fafc;fontSize=9.5;fontStyle=1;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1400" y="1584" width="104" height="22" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r0c2" value='&lt;b style="color:#0f172a"&gt;10&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#c4b5fd;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1400" y="1606" width="104" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r1c2" value='&lt;b style="color:#0f172a"&gt;8&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ddd6fe;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1400" y="1630" width="104" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r2c2" value='&lt;b style="color:#0f172a"&gt;6&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ddd6fe;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1400" y="1654" width="104" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r3c2" value='&lt;b style="color:#0f172a"&gt;4&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ede9fe;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1400" y="1678" width="104" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-h3" value="thorough" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#f8fafc;fontSize=9.5;fontStyle=1;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1504" y="1584" width="104" height="22" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r0c3" value='&lt;b style="color:#ffffff"&gt;20&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#8b5cf6;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1504" y="1606" width="104" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r1c3" value='&lt;b style="color:#ffffff"&gt;15&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#a78bfa;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1504" y="1630" width="104" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r2c3" value='&lt;b style="color:#0f172a"&gt;10&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#c4b5fd;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1504" y="1654" width="104" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-t-r3c3" value='&lt;b style="color:#0f172a"&gt;7&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ddd6fe;fontSize=11;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1504" y="1678" width="104" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-eng-notes" value="•&amp;nbsp; Extra-large data skips ExtraTrees and narrows the search ranges.&lt;br&gt;•&amp;nbsp; Every candidate uses the same split and seed; &lt;b&gt;n_jobs&lt;/b&gt; changes speed, never scores.&lt;br&gt;•&amp;nbsp; Scores come from one hold-out split: they rank candidates fairly but are optimistic as a generalisation estimate." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="1028" y="1716" width="584" height="70" as="geometry"/></mxCell>
        <mxCell id="e3-eng-a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;endFill=1;endSize=6;startArrow=none;strokeColor=#a78bfa;strokeWidth=1.2;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="1301" as="sourcePoint"/><mxPoint x="990" y="1301" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e3-eng-b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;endFill=1;endSize=6;startArrow=none;strokeColor=#a78bfa;strokeWidth=1.2;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="1534" as="sourcePoint"/><mxPoint x="990" y="1534" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p4-bg" value="" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;fillColor=#ecfdf5;strokeColor=#a7f3d0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1868" width="1620" height="178" as="geometry"/></mxCell>
        <mxCell id="p4-num" value="4" style="ellipse;whiteSpace=wrap;fillColor=#059669;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="70" y="1884" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="p4-title" value='&lt;span style="letter-spacing:0.05em"&gt;FIT FINAL TRANSFORMERS&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#065f46;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="1884" width="520" height="28" as="geometry"/></mxCell>
        <mxCell id="p4-badge0" value="_fit_final_processors()" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=none;fontColor=#065f46;fontSize=10;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=2;" vertex="1" parent="1"><mxGeometry x="346" y="1887" width="194" height="22" as="geometry"/></mxCell>
        <mxCell id="p4-in" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Recipe + Train Snapshot&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;choices from stage 3&lt;br&gt;rows from stage 2&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="1936" width="220" height="62" as="geometry"/></mxCell>
        <mxCell id="p4-cols" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Keep Final Columns&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;cols = n_cols + c_cols&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="323" y="1936" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="p4-scale" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Fit Scaler on n_cols&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;chosen type&lt;br&gt;standard | minmax | robust&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="566" y="1936" width="230" height="62" as="geometry"/></mxCell>
        <mxCell id="p4-enc" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Fit Encoder on c_cols&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;chosen type&lt;br&gt;ifrequency | label&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="829" y="1936" width="220" height="62" as="geometry"/></mxCell>
        <mxCell id="p4-imp" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Fit Imputer&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;chosen method, after encoding&lt;br&gt;mean fallback if none was needed&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1082" y="1936" width="250" height="62" as="geometry"/></mxCell>
        <mxCell id="p4-out" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Fitted Pipeline&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;fitted_components · state&lt;br&gt;is_fitted = True&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1365" y="1936" width="265" height="62" as="geometry"/></mxCell>
        <mxCell id="e4-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#6ee7b7;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" edge="1" parent="1" source="p4-in" target="p4-cols"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#6ee7b7;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" edge="1" parent="1" source="p4-cols" target="p4-scale"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#6ee7b7;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" edge="1" parent="1" source="p4-scale" target="p4-enc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#6ee7b7;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" edge="1" parent="1" source="p4-enc" target="p4-imp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#6ee7b7;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" edge="1" parent="1" source="p4-imp" target="p4-out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p4-note" value="&lt;b&gt;Fitted on the training split only.&lt;/b&gt; Validation rows and future data never change the state of these transformers." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="2012" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="p5-bg" value="" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;fillColor=#fff7ed;strokeColor=#fed7aa;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="2066" width="1620" height="344" as="geometry"/></mxCell>
        <mxCell id="p5-num" value="5" style="ellipse;whiteSpace=wrap;fillColor=#ea580c;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="70" y="2082" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="p5-title" value='&lt;span style="letter-spacing:0.05em"&gt;TRANSFORM NEW DATA&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#9a3412;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="2082" width="520" height="28" as="geometry"/></mxCell>
        <mxCell id="p5-badge0" value="data_processing(X)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=none;fontColor=#9a3412;fontSize=10;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=2;" vertex="1" parent="1"><mxGeometry x="306" y="2085" width="150" height="22" as="geometry"/></mxCell>
        <mxCell id="p5-badge1" value="transform(X)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=none;fontColor=#9a3412;fontSize=10;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=2;" vertex="1" parent="1"><mxGeometry x="464" y="2085" width="108" height="22" as="geometry"/></mxCell>
        <mxCell id="p5-new" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;New DataFrame&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;train · test · future&lt;br&gt;target optional&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="2138" width="170" height="66" as="geometry"/></mxCell>
        <mxCell id="p5-norm" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Normalize Types&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;bool → 0 / 1 float&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="273" y="2138" width="156" height="66" as="geometry"/></mxCell>
        <mxCell id="p5-dates" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Replay Dates&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;fitted datetime columns&lt;br&gt;text dates parsed back&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="462" y="2138" width="176" height="66" as="geometry"/></mxCell>
        <mxCell id="p5-schema" value="columns&lt;br&gt;present?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ea580c;strokeColor=#9a3412;strokeWidth=1.5;fontColor=#ffffff;fontSize=10;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="671" y="2129" width="108" height="84" as="geometry"/></mxCell>
        <mxCell id="p5-scale" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Scale n_cols&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;numeric text coerced&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="812" y="2138" width="160" height="66" as="geometry"/></mxCell>
        <mxCell id="p5-enc" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Encode c_cols&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;unseen categories handled&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1005" y="2138" width="186" height="66" as="geometry"/></mxCell>
        <mxCell id="p5-imp" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Impute&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;only if NaN remain&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1224" y="2138" width="156" height="66" as="geometry"/></mxCell>
        <mxCell id="p5-out" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Processed DataFrame&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;features (+ raw dates)&lt;br&gt;+ target, untouched&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=2;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1413" y="2138" width="217" height="66" as="geometry"/></mxCell>
        <mxCell id="p5-err" value='&lt;b style="font-size:11px;color:#991b1b"&gt;SchemaValidationError&lt;/b&gt;&lt;div style="margin-top:2px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9px;color:#b91c1c;"&gt;names every missing column&lt;br&gt;and its datetime source&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#f87171;strokeWidth=1.5;dashed=1;dashPattern=5 4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="625" y="2242" width="200" height="54" as="geometry"/></mxCell>
