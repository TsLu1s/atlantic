        <mxCell id="p1-cal-note" value="Parts that never vary (for example hour on date-only data) are then pruned as constant columns." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10;fontColor=#64748b;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="666" y="754" width="370" height="28" as="geometry"/></mxCell>
        <mxCell id="p1-guard-bg" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1070" y="636" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="p1-guard-label" value='&lt;span style="letter-spacing:0.07em"&gt;GUARD RAILS&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=9.5;fontColor=#64748b;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1086" y="648" width="420" height="14" as="geometry"/></mxCell>
        <mxCell id="p1-guard" value='&lt;b style="color:#b91c1c"&gt;Raises ValidationError&lt;/b&gt; when the input is not a DataFrame or is empty, the target is missing, column names repeat, an option is out of range, no usable feature is left, or a class has a single sample.&lt;div style="height:6px"&gt;&lt;/div&gt;&lt;b style="color:#b45309"&gt;Warns&lt;/b&gt; when a numeric target has only a few integer values: it is treated as regression, so cast class labels to str first.&lt;div style="height:6px"&gt;&lt;/div&gt;&lt;b style="color:#1e40af"&gt;Records&lt;/b&gt; every removed column in dropped_columns, by reason: datetime · high_null · constant · unique_identifier · feature_selection · multicollinearity.' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="1086" y="668" width="528" height="116" as="geometry"/></mxCell>
        <mxCell id="p2-bg" value="" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;fillColor=#ecfeff;strokeColor=#a5f3fc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="832" width="1620" height="296" as="geometry"/></mxCell>
        <mxCell id="p2-num" value="2" style="ellipse;whiteSpace=wrap;fillColor=#0891b2;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="70" y="848" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="p2-title" value='&lt;span style="letter-spacing:0.05em"&gt;SPLIT &amp;amp; SELECT FEATURES&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#155e75;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="848" width="520" height="28" as="geometry"/></mxCell>
        <mxCell id="p2-badge0" value="split_ratio" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=none;fontColor=#155e75;fontSize=10;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=2;" vertex="1" parent="1"><mxGeometry x="356" y="851" width="104" height="22" as="geometry"/></mxCell>
        <mxCell id="p2-badge1" value="relevance" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=none;fontColor=#155e75;fontSize=10;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=2;" vertex="1" parent="1"><mxGeometry x="468" y="851" width="90" height="22" as="geometry"/></mxCell>
        <mxCell id="p2-split" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Train / Validation Split&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;split_ratio 0.75 (0.5 – 0.98)&lt;br&gt;stratified for classification&lt;br&gt;seeded by random_state&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#67e8f9;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="910" width="236" height="76" as="geometry"/></mxCell>
        <mxCell id="p2-rel" value="relevance&lt;br&gt;&amp;lt; 1.0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#0891b2;strokeColor=#155e75;strokeWidth=1.5;fontColor=#ffffff;fontSize=10;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="334" y="906" width="108" height="84" as="geometry"/></mxCell>
        <mxCell id="p2-h2o" value="&lt;b style=&quot;font-size:11.5px;color:#0f172a&quot;&gt;H2O AutoML Feature Selection&lt;/b&gt;&lt;div style=&quot;margin-top:3px;line-height:1.35&quot;&gt;&lt;span style=&quot;font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;&quot;&gt;categoricals label-encoded first&lt;br&gt;h2o_fs_models models · 3-fold CV&lt;br&gt;keeps the leader's most important&lt;br&gt;features up to the relevance share&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#67e8f9;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="472" y="902" width="304" height="92" as="geometry"/></mxCell>
        <mxCell id="p2-snap" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Snapshot Train Split&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;pre-encoded copy for&lt;br&gt;the final fit (stage 4)&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0891b2;strokeWidth=2;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="804" y="910" width="202" height="76" as="geometry"/></mxCell>
        <mxCell id="p2-note" value='&lt;span style="font-size:9.5px;color:#92400e"&gt;needs &lt;span style="font-family:JetBrains Mono,monospace;font-size:9px;color:#92400e;font-weight:bold;"&gt;pip install "atlantic[h2o]"&lt;/span&gt; and Java · if missing, H2OConnectionError is raised before any work starts&lt;/span&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;dashed=1;dashPattern=4 3;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=8;spacingRight=8;align=left;" vertex="1" parent="1"><mxGeometry x="472" y="1008" width="304" height="40" as="geometry"/></mxCell>
        <mxCell id="e2-a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#67e8f9;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" edge="1" parent="1" source="p2-split" target="p2-rel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2-yes" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#67e8f9;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#15803d;labelBackgroundColor=#ecfeff;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" edge="1" parent="1" source="p2-rel" target="p2-h2o"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e2-b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#67e8f9;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" edge="1" parent="1" source="p2-h2o" target="p2-snap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2-note" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=none;endFill=1;endSize=6;startArrow=none;strokeColor=#f59e0b;strokeWidth=1.2;fontSize=10;fontStyle=1;fontColor=#64748b;labelBackgroundColor=none;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;dashed=1;dashPattern=5 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p2-h2o" target="p2-note"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2-no" value="No · all features kept" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#67e8f9;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#b91c1c;labelBackgroundColor=#ecfeff;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p2-rel" target="p2-snap"><mxGeometry relative="1" x="0.08" as="geometry"><Array as="points"><mxPoint x="388" y="1064"/><mxPoint x="905" y="1064"/></Array></mxGeometry></mxCell>
        <mxCell id="p2-leak-bg" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1030" y="894" width="600" height="216" as="geometry"/></mxCell>
        <mxCell id="p2-leak-label" value='&lt;span style="letter-spacing:0.07em"&gt;LEAKAGE BOUNDARY  ·  WHAT EACH STEP MAY LEARN FROM&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=9.5;fontColor=#64748b;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1048" y="906" width="420" height="14" as="geometry"/></mxCell>
        <mxCell id="p2-bar-train" value="train split  ·  75 %" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0891b2;strokeColor=none;fontColor=#ffffff;fontSize=10;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1048" y="930" width="420" height="24" as="geometry"/></mxCell>
        <mxCell id="p2-bar-val" value="validation  ·  25 %" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbbf24;strokeColor=none;fontColor=#451a03;fontSize=10;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1470" y="930" width="142" height="24" as="geometry"/></mxCell>
        <mxCell id="p2-leak-h0" value="Step" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#f8fafc;fontSize=9.5;fontStyle=1;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1048" y="966" width="250" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-r0c0" value="Candidate scalers, encoders, imputers" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=10;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1048" y="986" width="250" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-r1c0" value="Model search inside every evaluation" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=10;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1048" y="1006" width="250" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-r2c0" value="VIF filter · H2O selector" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=10;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1048" y="1026" width="250" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-r3c0" value="Final transformers (stage 4)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=10;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1048" y="1046" width="250" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-h1" value="Fitted on" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#f8fafc;fontSize=9.5;fontStyle=1;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1298" y="966" width="130" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-r0c1" value='&lt;b style="color:#0e7490"&gt;train split&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=10;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1298" y="986" width="130" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-r1c1" value='&lt;b style="color:#0e7490"&gt;train split&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=10;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1298" y="1006" width="130" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-r2c1" value='&lt;b style="color:#0e7490"&gt;train split&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=10;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1298" y="1026" width="130" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-r3c1" value='&lt;b style="color:#0e7490"&gt;train split&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=10;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1298" y="1046" width="130" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-h2" value="Validation rows" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#f8fafc;fontSize=9.5;fontStyle=1;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1428" y="966" width="184" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-r0c2" value='&lt;span style="color:#92400e"&gt;transformed, then scored&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=10;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1428" y="986" width="184" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-r1c2" value='&lt;span style="color:#92400e"&gt;scored, never trained on&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=10;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1428" y="1006" width="184" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-r2c2" value='&lt;span style="color:#92400e"&gt;not used&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=10;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1428" y="1026" width="184" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-r3c2" value='&lt;span style="color:#92400e"&gt;not used&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e2e8f0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#ffffff;fontSize=10;fontColor=#334155;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="1428" y="1046" width="184" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-leak-note" value="New data is only ever transformed with what was learned from the train split." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10;fontColor=#64748b;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="1048" y="1076" width="564" height="20" as="geometry"/></mxCell>
        <mxCell id="p3-bg" value="" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;fillColor=#f5f3ff;strokeColor=#ddd6fe;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1148" width="1620" height="700" as="geometry"/></mxCell>
        <mxCell id="p3-num" value="3" style="ellipse;whiteSpace=wrap;fillColor=#7c3aed;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="70" y="1164" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="p3-title" value='&lt;span style="letter-spacing:0.05em"&gt;SELECT BY VALIDATION SCORE&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#5b21b6;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="1164" width="520" height="28" as="geometry"/></mxCell>
        <mxCell id="p3-badge0" value="Pattern" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=none;fontColor=#5b21b6;fontSize=10;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=2;" vertex="1" parent="1"><mxGeometry x="385" y="1167" width="70" height="22" as="geometry"/></mxCell>
