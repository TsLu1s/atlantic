        <mxCell id="p3-vif" value='&lt;b style="font-size:11.5px;color:#0f172a"&gt;Iterative VIF Filter&lt;/b&gt;&lt;div style="margin-top:3px;line-height:1.35"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:9.5px;color:#64748b;"&gt;VIF from the inverse correlation&lt;br&gt;matrix · drop the worst column&lt;br&gt;while VIF ≥ vif_ratio (3 – 30)&lt;/span&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="1716" width="270" height="86" as="geometry"/></mxCell>
        <mxCell id="p3-improve" value="score&lt;br&gt;improves?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=#5b21b6;strokeWidth=1.5;fontColor=#ffffff;fontSize=10;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="372" y="1717" width="112" height="84" as="geometry"/></mxCell>
