        <mxCell id="p6-k3-title" value='&lt;b style="font-size:12px;color:#0f172a"&gt;Metadata export (JSON)&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="872" y="2506" width="336" height="18" as="geometry"/></mxCell>
        <mxCell id="p6-k3-body" value='&lt;div style="line-height:1.7"&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:10px;color:#0f172a;"&gt;StateManager.save_metadata(atl.state, path)&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:10px;color:#0f172a;"&gt;StateManager.load_metadata(path)&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:JetBrains Mono,monospace;font-size:10px;color:#0f172a;"&gt;StateManager.export_config(atl.state, path)&lt;/span&gt;&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontSize=10.5;fontColor=#475569;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;spacing=0;" vertex="1" parent="1"><mxGeometry x="872" y="2532" width="336" height="80" as="geometry"/></mxCell>
